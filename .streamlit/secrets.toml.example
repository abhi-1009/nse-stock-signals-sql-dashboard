# Copy to .streamlit/secrets.toml (NEVER commit the real file).
# On Streamlit Community Cloud paste the same block into App settings > Secrets.
# Best practice: use a READ-ONLY database user for the app (see README, step 5).
[mysql]
host     = "your-service-name.aivencloud.com"
port     = 12345
user     = "app_readonly"
password = "your-password"
database = "defaultdb"
# ssl_ca = "certs/aiven-ca.pem"   # optional; this is the default
